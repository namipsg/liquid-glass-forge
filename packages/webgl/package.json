{
  "name": "@liquid-glass-forge/webgl",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Experimental shared-atlas WebGL2 optics and optional vanilla integration",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
