    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "default": "./dist/dom.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "dependencies": {
    "@liquid-glass-forge/core": "0.0.0-dev",
    "@liquid-glass-forge/cpu": "0.0.0-dev",
    "@liquid-glass-forge/dom": "0.0.0-dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namipsg/liquid-glass-forge.git",
    "directory": "packages/webgl"
  }
}
