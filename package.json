{
  "name": "liquid-glass-forge-workspace",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node scripts/ssr-import.mjs",
    "test:unit": "node --test tests/core.test.mjs",
    "test:package-audit": "node --test tests/package-audit.test.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:browser-import": "node --test tests/browser-import.test.mjs",
    "test": "pnpm check && pnpm test:unit && pnpm test:package-audit && pnpm test:pack && pnpm test:browser-import"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2"
  }
}
