{
  "name": "liquid-glass-forge-workspace",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && node scripts/ssr-import.mjs",
    "test:unit": "node --test tests/core.test.mjs tests/sources.test.mjs tests/dynamic-sources.test.mjs tests/mapping.test.mjs tests/scene.test.mjs",
    "test:cpu": "node --test tests/cpu.test.mjs tests/cpu-colour-tables.test.mjs tests/cpu-baseline-fast.test.mjs tests/cpu-source-cache.test.mjs",
    "test:cpu-executor": "node --test tests/cpu-executor.test.mjs",
    "test:cpu-worker-browser": "node --test tests/cpu-worker-browser.test.mjs",
    "test:package-audit": "node --test tests/package-audit.test.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:browser-import": "node --test tests/browser-import.test.mjs",
    "test": "pnpm check && pnpm test:unit && pnpm test:cpu && pnpm test:cpu-executor && pnpm test:cpu-worker-browser && pnpm test:cpu-host-browser && pnpm test:package-audit && pnpm test:pack && pnpm test:browser-import && pnpm test:sources-browser && pnpm test:host-browser && pnpm test:webgl && pnpm test:webgl-browser && pnpm test:react && pnpm test:vue && pnpm test:angular",
    "test:sources-browser": "node --test tests/sources-browser.test.mjs tests/dynamic-browser.test.mjs tests/mapping-browser.test.mjs",
    "test:host-browser": "node --test tests/host-browser.test.mjs tests/scene-browser.test.mjs",
    "test:cpu-host-browser": "node --test tests/cpu-host-browser.test.mjs",
    "bench:cpu": "node scripts/bench-cpu.mjs",
    "test:webgl": "node --test tests/webgl.test.mjs",
    "test:webgl-browser": "node --test tests/webgl-browser.test.mjs",
    "bench:webgl": "node scripts/bench-webgl.mjs",
    "test:adapter": "node scripts/test-adapter.mjs",
    "test:react": "node scripts/test-react.mjs",
    "test:base": "pnpm check:base && pnpm test:unit && pnpm test:cpu && pnpm test:cpu-executor && pnpm test:cpu-worker-browser && pnpm test:cpu-host-browser && pnpm test:package-audit && node scripts/pack-smoke.mjs --base && pnpm test:browser-import && pnpm test:sources-browser && pnpm test:host-browser && pnpm test:webgl && pnpm test:webgl-browser && pnpm test:react",
    "test:vue": "node scripts/test-vue.mjs",
    "test:angular": "node scripts/test-angular.mjs",
    "check:base": "node scripts/build.mjs --base && node scripts/ssr-import.mjs --base"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.5",
    "next": "16.4.4",
    "vue": "3.5.44",
    "@vue/server-renderer": "3.5.44",
    "@vitejs/plugin-vue": "6.0.10",
    "nuxt": "4.6.4",
    "@angular/core": "22.2.4",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-server": "22.2.4",
    "@angular/router": "22.2.4",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  }
}
